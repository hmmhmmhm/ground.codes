{
  "name": "ground-codes",
  "version": "0.0.10",
  "description": "Ground codes",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup --config tsup.config.ts --watch",
    "build": "tsup --config tsup.config.ts",
    "test": "tsx --test test/*.test.ts",
    "test:standalone": "pnpm build && node scripts/check-standalone-package.mjs",
    "generate-spiral-fixture": "tsx scripts/generate-spiral-fixture.ts",
    "benchmark:spiral": "tsx scripts/benchmark-spiral.ts",
    "benchmark:spiral-scale": "tsx scripts/benchmark-spiral-scale.ts",
    "check:spiral-bigint": "tsx scripts/check-spiral-bigint.ts",
    "compare:spiral-baseline": "tsx scripts/compare-spiral-baseline.ts",
    "explore:spiral-math": "tsx scripts/explore-spiral-math.ts",
    "explore:spiral-index": "tsx scripts/explore-spiral-index.ts",
    "stress:spiral-edge-cases": "tsx scripts/stress-spiral-edge-cases.ts",
    "publish-package": "turbo run build lint test && pnpm test:standalone && changeset version && changeset publish"
  },
  "files": [
    "dist"
  ],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build"
      ]
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@repo/typescript-config": "workspace:*",
    "@repo/codebook": "workspace:*",
    "@ground-codes/geoint": "workspace:*",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3"
  },
  "dependencies": {}
}
