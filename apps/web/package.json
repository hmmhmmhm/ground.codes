{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "test": "bun test ./lib ./app",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.production.config.ts",
    "qa:visual": "playwright test e2e/visual-qa.spec.ts --config=playwright.production.config.ts",
    "pages:build": "npx @cloudflare/next-on-pages && node scripts/patch-pages-routes.mjs",
    "preview": "pnpm run pages:build && wrangler pages dev",
    "deploy": "pnpm run pages:build && wrangler pages deploy"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.6",
    "@repo/ui": "workspace:*",
    "@types/google.maps": "^3.58.1",
    "cesium": "^1.141.0",
    "next": "15.5.18",
    "next-intl": "^4.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.9",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
