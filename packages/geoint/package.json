{
  "name": "@ground-codes/geoint",
  "version": "0.0.5",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup --config tsup.config.ts --watch",
    "build": "tsup --config tsup.config.ts",
    "test": "tsx --test test/*.test.ts",
    "dataset-build": "tsx ./build-script/select-script.ts",
    "publish-package": "turbo run build lint test && changeset version && changeset publish"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "region-data-release.json"
  ],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build"
      ]
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "^1.2.1",
    "@changesets/cli": "^2.28.1",
    "@inquirer/prompts": "^7.3.2",
    "@inquirer/search": "^3.0.9",
    "@repo/typescript-config": "workspace:*",
    "@types/geokdbush": "^1.1.5",
    "@types/node": "^22.13.9",
    "ai": "^4.1.54",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "glob": "^11.0.1",
    "tasuku": "^2.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "geokdbush": "^2.1.0",
    "kdbush": "^4.1.0",
    "level": "^9.0.0"
  }
}
