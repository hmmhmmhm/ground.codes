{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api-ground-codes/Dockerfile",
    "watchPatterns": [
      "/apps/api-ground-codes/**",
      "/packages/ground-codes/**",
      "/packages/geoint/**",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/.npmrc",
      "/package.json",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter api-ground-codes start",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
